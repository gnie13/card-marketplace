# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# The public key (labelled "anon" or "publishable"). Safe to expose in the browser.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# The secret key (labelled "service_role" or "secret"). Server only. Never prefix with NEXT_PUBLIC.
SUPABASE_SERVICE_ROLE_KEY=
# Any long random string. Vercel sends it with the daily price refresh.
CRON_SECRET=
# Optional email alerts through resend.com. Leave blank to run without email.
RESEND_API_KEY=
# A sender on a domain you verified in Resend, for example: Card Marketplace <offers@yourdomain.com>
EMAIL_FROM=
